---
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  /** "studio" is the two-pane style page: fills the viewport, panes scroll, no footer. */
  variant?: "page" | "studio";
}
const { title, description, variant = "page" } = Astro.props;
const REPO = "https://github.com/karasbuilder/styles-md";
const AUTHOR = "https://github.com/karasbuilder";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  </head>
  <body class={variant}>
    <header class="site-head">
      <a class="brand" href="/" aria-label="styles-md home">
        <img src="/logo.svg" width="28" height="28" alt="" />
        {variant === "page" && <span class="wordmark">styles-md</span>}
      </a>
      {/* The browse chrome puts search in the bar itself; the studio keeps its plain nav. */}
      <slot name="head" />
      {variant === "page" ? (
        <nav class="head-actions">
          <a class="head-btn" href={`${REPO}/blob/main/CONTRIBUTING.md`}>Contribute</a>
          <a class="head-btn accent" href={REPO}>GitHub</a>
        </nav>
      ) : (
        <nav>
          <a href="/">Styles</a>
          <a href={REPO}>GitHub</a>
        </nav>
      )}
    </header>
    <main class="site-main"><slot /></main>
    {variant === "page" && (
      <footer class="site-foot">
        <span>Style specs are CC-BY-4.0. Tooling is MIT.</span>
        <span>Built by <a href={AUTHOR}>karas</a></span>
        <a href={REPO}>github.com/karasbuilder/styles-md</a>
      </footer>
    )}
  </body>
</html>
