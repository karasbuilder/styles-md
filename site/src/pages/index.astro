---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const entries = (await getCollection("styles")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

const searchDocs = entries.map((entry) => ({
  id: entry.data.id,
  name: entry.data.name,
  mood: entry.data.mood,
  summary: entry.data.summary,
  tags: entry.data.tags.join(" "),
}));

// Two axes people actually browse by: is it light or dark, and what is it for.
const TONES = ["light", "dark"];
const useTags = [...new Set(entries.flatMap((e) => e.data.tags))]
  .filter((tag) => !TONES.includes(tag))
  .sort()
  .slice(0, 8);
const filters = [...TONES, ...useTags];
---

<Base
  title="styles-md — design specs your coding agent can actually follow"
  description="An open library of DESIGN.md style specs. Machine-validated tokens, WCAG-checked palettes, one command to install."
>
  <div class="wrap intro">
    <h1>Design specs your coding agent can actually follow.</h1>
    <p class="lede">
      One Markdown file per style: hard tokens in the frontmatter, the rules that need judgment in
      the body. Every one is checked against a schema and WCAG AA before it ships.
    </p>
    <div class="install-hint">
      <code class="mono">npx styles-md add midnight-precision</code>
      <button class="copy" type="button" data-copy="npx styles-md add midnight-precision">Copy</button>
    </div>
  </div>

  <div class="wrap">
    <div class="filters">
      <input id="q" type="search" placeholder="Search styles" autocomplete="off" />
      <div class="chips">
        <span class="label">Filter</span>
        {filters.map((tag) => (
          <button class="chip" type="button" data-tag={tag} aria-pressed="false">{tag}</button>
        ))}
      </div>
      <p class="count" id="count">{entries.length} styles</p>
    </div>

    <div class="grid" id="grid">
      {entries.map((entry) => (
        <a class="style-card" href={`/styles/${entry.data.id}/`} data-id={entry.data.id}>
          <img
            class="thumb"
            src={`/styles/${entry.data.id}/preview.webp`}
            alt={`The demo page rendered in ${entry.data.name}`}
            width="1280"
            height="900"
            loading="lazy"
            style={`background:${entry.data.tokens.color.bg}`}
          />
          <div class="swatches">
            <span style={`background:${entry.data.tokens.color.bg}`}></span>
            <span style={`background:${entry.data.tokens.color.surface}`}></span>
            <span style={`background:${entry.data.tokens.color.muted}`}></span>
            <span style={`background:${entry.data.tokens.color.fg}`}></span>
            <span style={`background:${entry.data.tokens.color.accent}`}></span>
          </div>
          <div class="meta">
            <div class="top">
              <h3>{entry.data.name}</h3>
              <span class="go">View →</span>
            </div>
            <p class="mood">{entry.data.mood}</p>
            <div class="tags">
              {entry.data.tags.slice(0, 4).map((tag: string) => <span class="tag">{tag}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>
    <p class="empty" id="empty" hidden>Nothing matches that. Try a broader word.</p>
  </div>

  <script type="application/json" id="search-docs" set:html={JSON.stringify(searchDocs)} />

  <script>
    import MiniSearch from "minisearch";

    const docs: Array<{ id: string; tags: string }> = JSON.parse(
      document.getElementById("search-docs")!.textContent!,
    );
    const byId = new Map(docs.map((doc) => [doc.id, doc]));

    const search = new MiniSearch({
      fields: ["name", "mood", "summary", "tags"],
      storeFields: ["id"],
      searchOptions: { prefix: true, fuzzy: 0.2, boost: { name: 2, tags: 1.5 } },
    });
    search.addAll(docs);

    const input = document.getElementById("q") as HTMLInputElement;
    const grid = document.getElementById("grid")!;
    const empty = document.getElementById("empty")!;
    const count = document.getElementById("count")!;
    const chips = [...document.querySelectorAll<HTMLButtonElement>(".chip")];
    const cards = [...grid.querySelectorAll<HTMLElement>(".style-card")];
    let activeTag: string | null = null;

    function apply() {
      const query = input.value.trim();
      const matched = query ? new Set(search.search(query).map((r) => r.id as string)) : null;
      let visible = 0;

      for (const card of cards) {
        const id = card.dataset.id!;
        const okQuery = !matched || matched.has(id);
        const okTag = !activeTag || byId.get(id)!.tags.split(" ").includes(activeTag);
        const show = okQuery && okTag;
        card.hidden = !show;
        if (show) visible++;
      }

      empty.hidden = visible > 0;
      count.textContent =
        visible === cards.length
          ? `${cards.length} styles`
          : `${visible} of ${cards.length} styles`;
    }

    input.addEventListener("input", apply);
    for (const chip of chips) {
      chip.addEventListener("click", () => {
        activeTag = activeTag === chip.dataset.tag ? null : chip.dataset.tag!;
        for (const other of chips) {
          other.setAttribute("aria-pressed", String(other.dataset.tag === activeTag));
        }
        apply();
      });
    }

    for (const button of document.querySelectorAll<HTMLButtonElement>(".copy")) {
      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        const original = button.textContent;
        button.textContent = "Copied";
        button.dataset.done = "true";
        setTimeout(() => {
          button.textContent = original;
          delete button.dataset.done;
        }, 1600);
      });
    }
  </script>
</Base>
