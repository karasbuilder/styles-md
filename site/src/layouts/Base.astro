---
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  /** "studio" is the two-pane style page: fills the viewport, panes scroll, no footer. */
  variant?: "page" | "studio";
}
const { title, description, variant = "page" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  </head>
  <body class={variant}>
    <header class="site-head">
      <a class="brand" href="/" aria-label="styles-md — Home">
        <img src="/logo.svg" width="32" height="32" alt="" />
      </a>
      <nav>
        <a href="/">Styles</a>
        <a href="https://github.com/karasbuilder/styles-md">GitHub</a>
      </nav>
    </header>
    <main class="site-main"><slot /></main>
    {variant === "page" && (
      <footer class="site-foot">Style specs are CC-BY-4.0. Tooling is MIT.</footer>
    )}
  </body>
</html>
