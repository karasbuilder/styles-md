---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { getCollection, render } from "astro:content";
import { Code } from "astro:components";
import { deriveScales, estimateTokens } from "styles-md";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const entries = await getCollection("styles");
  return entries.map((entry) => ({ params: { slug: entry.data.id }, props: { entry } }));
}

const { entry } = Astro.props;
const style = entry.data;
const { Content } = await render(entry);

// Read the shipped artefacts rather than re-deriving them, so what the page shows
// is byte-identical to what `npx styles-md add` writes and what the CDN serves.
const read = (file: string) =>
  readFileSync(join(process.cwd(), "..", "styles", style.id, file), "utf8");

const files = {
  design: read("DESIGN.md"),
  compact: read("DESIGN.min.md"),
  tailwind: read("theme.css"),
  css: read("style.css"),
  tokens: read("tokens.json"),
};

const scales = deriveScales(style.tokens as never);
const colors = Object.entries(style.tokens.color).filter(([, v]) => v) as [string, string][];
const kebab = (s: string) => s.replace(/([a-z])([A-Z])/g, "$1-$2").toLowerCase();

const TABS = [
  { id: "design", label: "DESIGN.md", file: "DESIGN.md" },
  { id: "tailwind", label: "Tailwind v4", file: "theme.css" },
  { id: "css", label: "CSS Variables", file: "style.css" },
  { id: "tokens", label: "Design Tokens", file: "tokens.json" },
];

const shape = [
  ["stroke", style.tokens.stroke.width],
  ["radius", `${style.tokens.radius.sm} · ${style.tokens.radius.md} · ${style.tokens.radius.lg}`],
  ["spacing unit", style.tokens.space.unit],
  ["gutter", style.tokens.space.gutter],
  ["section gap", style.tokens.space.section],
  ["max width", style.tokens.space.maxWidth],
  ["motion", `${style.tokens.motion.duration} ${style.tokens.motion.easing}`],
];

const shiki = { light: "github-light", dark: "github-dark" } as const;

const font = style.tokens.font;

/** The family a stack actually asks for. The rest of the stack is the safety net. */
const primary = (stack: string) => stack.split(",")[0]!.trim().replace(/^["']|["']$/g, "");

/** CSS keywords resolve everywhere, so an "is it installed?" chip would be noise. */
const GENERIC = new Set([
  "serif", "sans-serif", "monospace", "cursive", "fantasy", "system-ui",
  "ui-sans-serif", "ui-serif", "ui-monospace", "ui-rounded", "math", "emoji",
]);

/**
 * Headings render in the display face when a style ships one, the same
 * `var(--sm-font-display, var(--sm-font-sans))` fallback the demo uses. Showing
 * every specimen in the sans stack would misrepresent half the styles.
 */
const headingStack = font.display ?? font.sans;

const roles = [
  {
    roles: font.display ? ["Body"] : ["Body", "headings"],
    stack: font.sans,
    weight: font.weightBody,
    tracking: 0,
    sample: "Aa Bb Cc 0123 The quick brown fox",
  },
  ...(font.display
    ? [{
        roles: ["Headings"],
        stack: font.display,
        weight: font.weightHeading,
        tracking: font.headingTracking,
        sample: "Aa Bb Cc 0123 The quick brown fox",
      }]
    : []),
  {
    roles: ["Code"],
    stack: font.mono,
    weight: font.weightBody,
    tracking: 0,
    sample: "const total = 1 + lI0O;",
  },
];

/** "Body, headings & code": a style that reuses one stack should say so once. */
const listRoles = (items: string[]) =>
  items.length < 2 ? items[0]! : `${items.slice(0, -1).join(", ")} & ${items.at(-1)!.toLowerCase()}`;

// Several styles set the same stack for two roles (mono-only styles set all
// three). Listing it twice reads as a mistake, so merge on the stack itself.
const faces = roles
  .filter((face, i) => roles.findIndex((other) => other.stack === face.stack) === i)
  .map((face) => ({
    ...face,
    family: primary(face.stack),
    label: listRoles(
      roles.filter((other) => other.stack === face.stack).flatMap((other) => other.roles),
    ),
  }));

/**
 * The built-in demo always leads. It is the only preview that renders identical
 * content across every style, which is what makes the gallery comparable. Real
 * sites built with the style follow.
 */
const sources = [
  { label: "Demo", url: `/demo/${style.id}/`, embed: true, note: "" },
  ...style.showcase.map((site) => ({
    label: site.label,
    url: site.url,
    embed: site.embed,
    note: site.note ?? "",
  })),
];
---

<Base title={`${style.name} · styles-md`} description={style.summary} variant="studio">
  <div class="studio">
    <!-- LEFT: what the style looks like. Visual only, no file contents here. -->
    <section class="pane visual">
      <a class="back" href="/">← All styles</a>

      <div class="frame">
        <div class="frame-bar">
          {sources.length > 1 ? (
            <div class="preview-tabs" role="tablist">
              {sources.map((source, i) => (
                <button
                  class="preview-tab"
                  role="tab"
                  type="button"
                  data-source={i}
                  data-url={source.url}
                  data-embed={String(source.embed)}
                  data-note={source.note}
                  aria-selected={String(i === 0)}
                >{source.label}</button>
              ))}
            </div>
          ) : (
            <span>Live preview</span>
          )}
          <a id="open-source" href={`/demo/${style.id}/`} target="_blank" rel="noreferrer">
            Open full page ↗
          </a>
        </div>

        <iframe
          id="preview-frame"
          src={`/demo/${style.id}/`}
          title={`${style.name} demo`}
          loading="lazy"
          sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
          referrerpolicy="no-referrer"></iframe>

        <!-- Shown for sites that forbid framing, and on narrow screens. -->
        <div class="offsite" id="offsite" hidden>
          <p class="who" id="offsite-label"></p>
          <p class="note" id="offsite-note"></p>
          <a class="copy" id="offsite-link" href="#" target="_blank" rel="noreferrer">Open site ↗</a>
        </div>

        <img
          class="still"
          src={`/styles/${style.id}/preview.webp`}
          alt={`The demo page rendered in ${style.name}`}
          width="1280"
          height="900"
          loading="lazy"
        />
      </div>

      <header class="ident">
        <h1>{style.name}</h1>
        <p class="mood">{style.mood}</p>
        <p class="summary">{style.summary}</p>
        <div class="tags">
          {style.tags.map((tag: string) => <span class="tag">{tag}</span>)}
          <span class="tag">v{style.version}</span>
          <span class="tag">{style.license}</span>
        </div>
      </header>

      <div class="block">
        <h2>Install</h2>
        <div class="cmd">
          <code>npx styles-md add {style.id}</code>
          <button class="copy" type="button" data-copy={`npx styles-md add ${style.id}`}>Copy</button>
        </div>
      </div>

      <div class="block">
        <h2>Palette</h2>
        <div class="palette">
          {colors.map(([name, value]) => (
            <div class="swatch">
              <div class="chipc" style={`background:${value}`}></div>
              <span class="n">{kebab(name)}</span>
              <span class="v">{value}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="block">
        <h2>Type</h2>
        <div class="faces">
          {faces.map((face) => (
            <div class="face">
              <div class="face-head">
                <span class="role">{face.label}</span>
                <span class="family">{face.family}</span>
                {!GENERIC.has(face.family.toLowerCase()) && (
                  <span class="avail" data-family={face.family} hidden></span>
                )}
              </div>
              <p
                class="sample"
                style={`font-family:${face.stack}; font-weight:${face.weight}; letter-spacing:${face.tracking}em`}
              >{face.sample}</p>
              <code class="stack">{face.stack}</code>
            </div>
          ))}
        </div>
        <p class="note">
          {font.baseSize} base · {font.scale} ratio · body {font.weightBody} / heading
          {" "}{font.weightHeading} · heading tracking {font.headingTracking}em. Fonts are not
          bundled. Install the first family in each stack, or the specimens below fall back to
          the next one your device has.
        </p>
        <div class="specimens">
          {[...scales.type].reverse().map((step) => (
            <div class="specimen">
              <span class="k">{step.name} · {step.size}</span>
              <p
                style={`font-family:${headingStack}; font-size:${step.size}; font-weight:${font.weightHeading}; letter-spacing:${font.headingTracking}em; line-height:1.2`}
              >The quick brown fox jumps</p>
            </div>
          ))}
        </div>
      </div>

      <div class="block">
        <h2>Shape, space &amp; motion</h2>
        <dl class="spec">
          {shape.map(([key, value]) => (
            <>
              <dt>{key}</dt>
              <dd>{value}</dd>
            </>
          ))}
        </dl>
      </div>
    </section>

    <!-- RIGHT: the artefact itself, one format at a time. -->
    <section class="pane source">
      <div class="tabs" role="tablist">
        {TABS.map((tab, i) => (
          <button
            class="tab"
            role="tab"
            type="button"
            data-tab={tab.id}
            data-file={tab.file}
            aria-selected={String(i === 0)}
          >{tab.label}</button>
        ))}
      </div>

      <div class="toolbar">
        <div class="modes" id="modes">
          <button class="mode" type="button" data-mode="design" aria-pressed="true">Full</button>
          <button class="mode" type="button" data-mode="compact" aria-pressed="false">
            Compact · ~{estimateTokens(files.compact)} tokens
          </button>
        </div>
        <button class="copy" type="button" id="copy-source">Copy</button>
        <a class="copy" id="download" href={`/styles/${style.id}/DESIGN.md`} download>Download</a>
      </div>

      <div class="viewer">
        <div class="panel prose" data-panel="design"><Content /></div>
        <div class="panel" data-panel="compact" hidden>
          <Code code={files.compact} lang="markdown" themes={shiki} defaultColor={false} />
        </div>
        <div class="panel" data-panel="tailwind" hidden>
          <Code code={files.tailwind} lang="css" themes={shiki} defaultColor={false} />
        </div>
        <div class="panel" data-panel="css" hidden>
          <Code code={files.css} lang="css" themes={shiki} defaultColor={false} />
        </div>
        <div class="panel" data-panel="tokens" hidden>
          <Code code={files.tokens} lang="json" themes={shiki} defaultColor={false} />
        </div>
      </div>
    </section>
  </div>

  <script type="application/json" id="sources" set:html={JSON.stringify(files)} />

  <script>
    // Preview sources: the built-in demo plus any real sites built with this style.
    // A site that forbids framing gets a link card rather than a blank rectangle.
    const sourceTabs = [...document.querySelectorAll<HTMLButtonElement>(".preview-tab")];
    if (sourceTabs.length > 0) {
      const frame = document.getElementById("preview-frame") as HTMLIFrameElement;
      const offsite = document.getElementById("offsite")!;
      const offsiteLabel = document.getElementById("offsite-label")!;
      const offsiteNote = document.getElementById("offsite-note")!;
      const offsiteLink = document.getElementById("offsite-link") as HTMLAnchorElement;
      const openLink = document.getElementById("open-source") as HTMLAnchorElement;

      for (const tab of sourceTabs) {
        tab.addEventListener("click", () => {
          const url = tab.dataset.url!;
          const embed = tab.dataset.embed === "true";
          const external = !url.startsWith("/");

          for (const other of sourceTabs) {
            other.setAttribute("aria-selected", String(other === tab));
          }
          openLink.href = url;
          openLink.textContent = external ? "Open site ↗" : "Open full page ↗";

          if (embed) {
            if (frame.getAttribute("src") !== url) frame.setAttribute("src", url);
            frame.hidden = false;
            offsite.hidden = true;
          } else {
            frame.hidden = true;
            offsite.hidden = false;
            offsiteLabel.textContent = tab.textContent;
            offsiteNote.textContent =
              tab.dataset.note || "This site does not allow embedding. Open it in a new tab.";
            offsiteLink.href = url;
          }
        });
      }
    }

    // Nothing here is web-hosted, so a specimen may be rendering a fallback the
    // style never asked for. Measuring the family against two generics tells the
    // visitor which of the two they are looking at.
    const chips = [...document.querySelectorAll<HTMLElement>(".avail[data-family]")];
    if (chips.length > 0) {
      const ctx = document.createElement("canvas").getContext("2d")!;
      const probe = "mmmwwwiiil1O0 The quick brown fox";

      const resolves = (family: string) =>
        ["monospace", "serif"].some((generic) => {
          ctx.font = `32px ${generic}`;
          const base = ctx.measureText(probe).width;
          ctx.font = `32px "${family}", ${generic}`;
          return Math.abs(ctx.measureText(probe).width - base) > 0.5;
        });

      const paint = () => {
        for (const chip of chips) {
          const family = chip.dataset.family!;
          const installed = resolves(family);
          chip.dataset.installed = String(installed);
          chip.textContent = installed ? "on this device" : "not installed";
          chip.title = installed
            ? `${family} is available here, so this specimen is accurate`
            : `${family} is missing, so this specimen uses the next family in the stack`;
          chip.hidden = false;
        }
      };

      if (document.fonts?.ready) void document.fonts.ready.then(paint);
      else paint();
    }

    const sources: Record<string, string> = JSON.parse(
      document.getElementById("sources")!.textContent!,
    );
    const slug = location.pathname.split("/").filter(Boolean).at(-1)!;

    const tabs = [...document.querySelectorAll<HTMLButtonElement>(".tab")];
    const modes = [...document.querySelectorAll<HTMLButtonElement>(".mode")];
    const panels = [...document.querySelectorAll<HTMLElement>(".panel")];
    const modeBar = document.getElementById("modes")!;
    const download = document.getElementById("download") as HTMLAnchorElement;

    let tab = "design";
    let mode = "design"; // only meaningful while the DESIGN.md tab is active

    function activePanel() {
      return tab === "design" ? mode : tab;
    }

    function apply() {
      const active = activePanel();
      for (const panel of panels) panel.hidden = panel.dataset.panel !== active;
      for (const button of tabs) button.setAttribute("aria-selected", String(button.dataset.tab === tab));
      for (const button of modes) button.setAttribute("aria-pressed", String(button.dataset.mode === mode));

      // Full/Compact only applies to the Markdown spec.
      modeBar.hidden = tab !== "design";

      const file =
        active === "compact"
          ? "DESIGN.min.md"
          : (tabs.find((t) => t.dataset.tab === tab)!.dataset.file as string);
      download.href = `/styles/${slug}/${file}`;
      download.setAttribute("download", file);
    }

    for (const button of tabs) {
      button.addEventListener("click", () => {
        tab = button.dataset.tab!;
        apply();
      });
    }
    for (const button of modes) {
      button.addEventListener("click", () => {
        mode = button.dataset.mode!;
        apply();
      });
    }

    document.getElementById("copy-source")!.addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      await navigator.clipboard.writeText(sources[activePanel()]);
      button.textContent = "Copied";
      button.dataset.done = "true";
      setTimeout(() => {
        button.textContent = "Copy";
        delete button.dataset.done;
      }, 1600);
    });

    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        const original = button.textContent;
        button.textContent = "Copied";
        button.dataset.done = "true";
        setTimeout(() => {
          button.textContent = original;
          delete button.dataset.done;
        }, 1600);
      });
    }

    apply();
  </script>
</Base>
