---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { getCollection, render } from "astro:content";
import { deriveScales, estimateTokens } from "styles-md";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const entries = await getCollection("styles");
  return entries.map((entry) => ({ params: { slug: entry.data.id }, props: { entry } }));
}

const { entry } = Astro.props;
const style = entry.data;
const { Content } = await render(entry);

// The minified spec is a build artefact of the CLI, not something the site
// re-derives — offering the real file keeps the site honest about what ships.
const minPath = join(process.cwd(), "..", "styles", style.id, "DESIGN.min.md");
const minified = readFileSync(minPath, "utf8");

const scales = deriveScales(style.tokens as never);
const colors = Object.entries(style.tokens.color).filter(([, v]) => v) as [string, string][];

const installs = [
  { label: "CSS variables", cmd: `npx styles-md add ${style.id}` },
  { label: "Tailwind v4", cmd: `npx styles-md add ${style.id} --target tailwind` },
  { label: "shadcn/ui", cmd: `npx styles-md add ${style.id} --target shadcn` },
];

const shape = [
  ["stroke", style.tokens.stroke.width],
  ["radius sm / md / lg", `${style.tokens.radius.sm} · ${style.tokens.radius.md} · ${style.tokens.radius.lg}`],
  ["spacing unit", style.tokens.space.unit],
  ["gutter", style.tokens.space.gutter],
  ["section gap", style.tokens.space.section],
  ["max width", style.tokens.space.maxWidth],
  ["duration", style.tokens.motion.duration],
  ["easing", style.tokens.motion.easing],
];
---

<Base title={`${style.name} — styles-md`} description={style.summary}>
  <div class="wrap detail">
    <a class="back" href="/">← All styles</a>

    <header class="ident">
      <h1>{style.name}</h1>
      <p class="mood">{style.mood}</p>
      <p class="lede">{style.summary}</p>
      <div class="tags">
        {style.tags.map((tag: string) => <span class="tag">{tag}</span>)}
      </div>
      <p class="fine">v{style.version} · {style.license} · {style.quality}</p>
    </header>

    <section class="preview">
      <div class="preview-bar">
        <span>Live preview — every style renders this same page</span>
        <a href={`/demo/${style.id}/`} target="_blank" rel="noreferrer">Open full page ↗</a>
      </div>
      <iframe src={`/demo/${style.id}/`} title={`${style.name} demo`} loading="lazy"></iframe>
      <img
        class="still"
        src={`/styles/${style.id}/preview.webp`}
        alt={`The demo page rendered in ${style.name}`}
        width="1280"
        height="900"
        loading="lazy"
      />
    </section>

    <div class="layout">
      <div class="col">
        <section>
          <div class="rule"><h2>Palette</h2></div>
          <div class="palette">
            {colors.map(([name, value]) => (
              <div class="swatch">
                <div class="chipc" style={`background:${value}`}></div>
                <span class="n">{name.replace(/([a-z])([A-Z])/g, "$1-$2").toLowerCase()}</span>
                <span class="v">{value}</span>
              </div>
            ))}
          </div>

          <div class="two">
            <div>
              <div class="rule"><h2>Type</h2></div>
              <dl class="spec">
                <dt>base · ratio</dt>
                <dd>{style.tokens.font.baseSize} · {style.tokens.font.scale}</dd>
                {scales.type.map((step) => (
                  <>
                    <dt>{step.name}</dt>
                    <dd>{step.size}</dd>
                  </>
                ))}
                <dt>body · heading weight</dt>
                <dd>{style.tokens.font.weightBody} · {style.tokens.font.weightHeading}</dd>
                <dt>heading tracking</dt>
                <dd>{style.tokens.font.headingTracking}em</dd>
              </dl>
            </div>

            <div>
              <div class="rule"><h2>Shape, space &amp; motion</h2></div>
              <dl class="spec">
                {shape.map(([key, value]) => (
                  <>
                    <dt>{key}</dt>
                    <dd>{value}</dd>
                  </>
                ))}
              </dl>
            </div>
          </div>
        </section>

        <section>
          <div class="rule"><h2>The spec</h2></div>
          <div class="prose"><Content /></div>
        </section>
      </div>

      <aside>
        <div>
          <div class="rule"><h2>Install</h2></div>
          <div class="install">
            <div class="targets">
              {installs.map((install, i) => (
                <button
                  class="chip"
                  type="button"
                  data-cmd={install.cmd}
                  aria-pressed={String(i === 0)}
                >{install.label}</button>
              ))}
            </div>
            <div class="cmd">
              <code id="install-cmd">{installs[0].cmd}</code>
              <button class="copy" type="button" data-copy={installs[0].cmd}>Copy</button>
            </div>
          </div>
        </div>

        <div class="agent">
          <div class="rule"><h2>For your agent</h2></div>
          <p>
            <code class="mono">DESIGN.min.md</code> is the token-budgeted spec — roughly
            {" "}{estimateTokens(minified)} tokens of hard numbers and rules, no prose.
          </p>
          <button class="copy" type="button" data-copy-target="min-source">Copy DESIGN.min.md</button>
          <details>
            <summary>Preview the file</summary>
            <pre id="min-source">{minified}</pre>
          </details>
        </div>
      </aside>
    </div>
  </div>

  <script>
    // One command line, three targets — showing all three at rail width truncated
    // them to the same visible text, which read as a bug.
    const cmdEl = document.getElementById("install-cmd")!;
    const cmdCopy = cmdEl.parentElement!.querySelector<HTMLButtonElement>(".copy")!;
    const targets = [...document.querySelectorAll<HTMLButtonElement>(".targets .chip")];

    for (const target of targets) {
      target.addEventListener("click", () => {
        const cmd = target.dataset.cmd!;
        cmdEl.textContent = cmd;
        cmdCopy.dataset.copy = cmd;
        for (const other of targets) {
          other.setAttribute("aria-pressed", String(other === target));
        }
      });
    }

    for (const button of document.querySelectorAll<HTMLButtonElement>(".copy")) {
      button.addEventListener("click", async () => {
        const targetId = button.dataset.copyTarget;
        const text = targetId
          ? (document.getElementById(targetId)?.textContent ?? "")
          : (button.dataset.copy ?? "");
        if (!text) return;

        await navigator.clipboard.writeText(text);
        const original = button.textContent;
        button.textContent = "Copied";
        button.dataset.done = "true";
        setTimeout(() => {
          button.textContent = original;
          delete button.dataset.done;
        }, 1600);
      });
    }
  </script>
</Base>
