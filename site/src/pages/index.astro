---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const entries = (await getCollection("styles")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

/**
 * The search index carries more than the prose: font stacks make "serif", "mono"
 * and "Inter" findable, and the hex values let someone paste a colour they
 * already have. Both are things people actually search a style library for.
 */
const searchDocs = entries.map((entry) => {
  const { font, color } = entry.data.tokens;
  return {
    id: entry.data.id,
    name: entry.data.name,
    mood: entry.data.mood,
    summary: entry.data.summary,
    tags: entry.data.tags.join(" "),
    type: [font.sans, font.mono, font.display ?? ""].join(" "),
    palette: Object.values(color).filter(Boolean).join(" "),
  };
});

// Facets are derived from the tags themselves — there is no second taxonomy to
// keep in sync. Tone is split out because it is the first thing anyone filters on.
const TONES = ["light", "dark"];

const tagCounts = new Map<string, number>();
for (const entry of entries) {
  for (const tag of entry.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}

const useTags = [...tagCounts.entries()]
  .filter(([tag]) => !TONES.includes(tag))
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag]) => tag);

const PRIMARY = 10;
const facets = [
  { group: "Tone", tags: TONES, rest: [] as string[] },
  { group: "Use", tags: useTags.slice(0, PRIMARY), rest: useTags.slice(PRIMARY) },
];
---

<Base
  title="styles-md — design specs your coding agent can actually follow"
  description="An open library of DESIGN.md style specs. Machine-validated tokens, WCAG-checked palettes, one command to install."
>
  <div class="wrap intro">
    <h1>Design specs your coding agent can actually follow.</h1>
    <p class="lede">
      One Markdown file per style: hard tokens in the frontmatter, the rules that need judgment in
      the body. Every one is checked against a schema and WCAG AA before it ships.
    </p>
    <div class="install-hint">
      <code class="mono">npx styles-md add midnight-precision</code>
      <button class="copy" type="button" data-copy="npx styles-md add midnight-precision">Copy</button>
    </div>
  </div>

  <div class="wrap">
    <search class="filters">
      <div class="searchbox">
        <input
          id="q"
          type="search"
          placeholder="Search by name, mood, tag, font or hex — try “dense”, “serif”, “#7c8cf8”"
          autocomplete="off"
          aria-label="Search styles"
        />
        <kbd>/</kbd>
      </div>

      {facets.map((facet) => (
        <div class="facet">
          <span class="label">{facet.group}</span>
          <div class="chips">
            {facet.tags.map((tag) => (
              <button class="chip" type="button" data-tag={tag} aria-pressed="false">
                {tag}<span class="n" data-count-for={tag}></span>
              </button>
            ))}
            {facet.rest.length > 0 && (
              <>
                {facet.rest.map((tag) => (
                  <button class="chip extra" type="button" data-tag={tag} aria-pressed="false" hidden>
                    {tag}<span class="n" data-count-for={tag}></span>
                  </button>
                ))}
                <button class="chip more" type="button" id="more">+{facet.rest.length} more</button>
              </>
            )}
          </div>
        </div>
      ))}

      <div class="status">
        <p class="count" id="count">{entries.length} styles</p>
        <button class="linkish" type="button" id="clear" hidden>Clear all</button>
      </div>
    </search>

    <div class="grid" id="grid">
      {entries.map((entry) => (
        <a class="style-card" href={`/styles/${entry.data.id}/`} data-id={entry.data.id}>
          <img
            class="thumb"
            src={`/styles/${entry.data.id}/preview.webp`}
            alt={`The demo page rendered in ${entry.data.name}`}
            width="1280"
            height="900"
            loading="lazy"
            style={`background:${entry.data.tokens.color.bg}`}
          />
          <div class="swatches">
            <span style={`background:${entry.data.tokens.color.bg}`}></span>
            <span style={`background:${entry.data.tokens.color.surface}`}></span>
            <span style={`background:${entry.data.tokens.color.muted}`}></span>
            <span style={`background:${entry.data.tokens.color.fg}`}></span>
            <span style={`background:${entry.data.tokens.color.accent}`}></span>
          </div>
          <div class="meta">
            <div class="top">
              <h3>{entry.data.name}</h3>
              <span class="go">View →</span>
            </div>
            <p class="mood">{entry.data.mood}</p>
            <div class="tags">
              {entry.data.tags.slice(0, 4).map((tag: string) => <span class="tag">{tag}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="empty" id="empty" hidden>
      <p>Nothing matches that.</p>
      <button class="copy" type="button" id="reset">Clear search and filters</button>
    </div>
  </div>

  <script type="application/json" id="search-docs" set:html={JSON.stringify(searchDocs)} />

  <script>
    import MiniSearch from "minisearch";

    type Doc = {
      id: string;
      name: string;
      mood: string;
      summary: string;
      tags: string;
      type: string;
      palette: string;
    };

    const docs: Doc[] = JSON.parse(document.getElementById("search-docs")!.textContent!);
    const tagsById = new Map(docs.map((d) => [d.id, new Set(d.tags.split(" "))]));

    const search = new MiniSearch<Doc>({
      fields: ["name", "mood", "summary", "tags", "type", "palette"],
      storeFields: ["id"],
      // Hex values and font names are punctuation-heavy; keep them intact as terms.
      tokenize: (text) => text.split(/[\s,"'`]+/).filter(Boolean),
      processTerm: (term) => term.replace(/[.;:()]+$/g, "").toLowerCase() || null,
      searchOptions: {
        prefix: true,
        fuzzy: 0.2,
        boost: { name: 3, tags: 2, mood: 1.5 },
      },
    });
    search.addAll(docs);

    const input = document.getElementById("q") as HTMLInputElement;
    const grid = document.getElementById("grid")!;
    const empty = document.getElementById("empty")!;
    const count = document.getElementById("count")!;
    const clear = document.getElementById("clear") as HTMLButtonElement;
    const more = document.getElementById("more") as HTMLButtonElement | null;
    const chips = [...document.querySelectorAll<HTMLButtonElement>(".chip[data-tag]")];
    const cards = [...grid.querySelectorAll<HTMLElement>(".style-card")];

    const selected = new Set<string>();

    /** Ids matching the query alone, or null when there is no query. */
    function queryMatches(): Set<string> | null {
      const query = input.value.trim();
      if (!query) return null;
      return new Set(search.search(query).map((r) => r.id as string));
    }

    /** A style matches when it carries every selected tag (AND across choices). */
    function hasTags(id: string, tags: Iterable<string>): boolean {
      const own = tagsById.get(id)!;
      for (const tag of tags) if (!own.has(tag)) return false;
      return true;
    }

    function readUrl() {
      const params = new URLSearchParams(location.search);
      input.value = params.get("q") ?? "";
      selected.clear();
      for (const tag of (params.get("tags") ?? "").split(",").filter(Boolean)) selected.add(tag);
    }

    function writeUrl() {
      const params = new URLSearchParams();
      if (input.value.trim()) params.set("q", input.value.trim());
      if (selected.size) params.set("tags", [...selected].join(","));
      const query = params.toString();
      // replaceState, not pushState: filtering should not fill up the back button.
      history.replaceState(null, "", query ? `?${query}` : location.pathname);
    }

    function apply() {
      const matched = queryMatches();
      let visible = 0;

      for (const card of cards) {
        const id = card.dataset.id!;
        const show = (!matched || matched.has(id)) && hasTags(id, selected);
        card.hidden = !show;
        if (show) visible++;
      }

      // Facet counts reflect what each chip would add on top of the current state,
      // so a chip reading 0 is one that would empty the grid.
      for (const chip of chips) {
        const tag = chip.dataset.tag!;
        const on = selected.has(tag);
        const probe = new Set(selected);
        probe.add(tag);
        const n = docs.filter(
          (d) => (!matched || matched.has(d.id)) && hasTags(d.id, probe),
        ).length;

        chip.setAttribute("aria-pressed", String(on));
        chip.querySelector(".n")!.textContent = on ? "" : ` ${n}`;
        chip.toggleAttribute("disabled", !on && n === 0);
      }

      empty.hidden = visible > 0;
      count.textContent =
        visible === cards.length
          ? `${cards.length} styles`
          : `${visible} of ${cards.length} styles`;
      clear.hidden = !input.value.trim() && selected.size === 0;

      writeUrl();
    }

    function reset() {
      input.value = "";
      selected.clear();
      apply();
    }

    input.addEventListener("input", apply);
    for (const chip of chips) {
      chip.addEventListener("click", () => {
        const tag = chip.dataset.tag!;
        if (selected.has(tag)) selected.delete(tag);
        else selected.add(tag);
        apply();
      });
    }

    clear.addEventListener("click", reset);
    document.getElementById("reset")!.addEventListener("click", reset);

    more?.addEventListener("click", () => {
      for (const chip of document.querySelectorAll<HTMLElement>(".chip.extra")) chip.hidden = false;
      more.hidden = true;
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "/" && document.activeElement !== input) {
        event.preventDefault();
        input.focus();
      } else if (event.key === "Escape" && document.activeElement === input) {
        reset();
        input.blur();
      }
    });

    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        const original = button.textContent;
        button.textContent = "Copied";
        button.dataset.done = "true";
        setTimeout(() => {
          button.textContent = original;
          delete button.dataset.done;
        }, 1600);
      });
    }

    // A shared link like ?q=dense&tags=dark must land on the same filtered view.
    readUrl();
    if (selected.size > 0 && [...selected].some((tag) => !chips.some((c) => c.dataset.tag === tag))) {
      selected.clear();
    }
    for (const chip of document.querySelectorAll<HTMLElement>(".chip.extra")) {
      if (selected.has((chip as HTMLButtonElement).dataset.tag!)) {
        chip.hidden = false;
        if (more) more.hidden = true;
      }
    }
    apply();
  </script>
</Base>
