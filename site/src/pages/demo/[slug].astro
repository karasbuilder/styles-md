---
import { getCollection } from "astro:content";
import { toCss } from "styles-md";
import Demo from "../../components/Demo.astro";

export async function getStaticPaths() {
  const entries = await getCollection("styles");
  return entries.map((entry) => ({
    params: { slug: entry.data.id },
    props: { style: entry.data },
  }));
}

const { style } = Astro.props;
// `:root` scope, standalone page, exactly what the screenshot job renders.
const css = toCss(style as never);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{style.name} · styles-md demo</title>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <style set:html={css} />
    <style>
      html, body { margin: 0; padding: 0; }
    </style>
  </head>
  <body>
    <Demo name={style.name} mood={style.mood} />
  </body>
</html>
