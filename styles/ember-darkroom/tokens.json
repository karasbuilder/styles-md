{
  "id": "ember-darkroom",
  "name": "Ember Darkroom",
  "version": "1.0.0",
  "license": "CC-BY-4.0",
  "mood": "one object lit in a warm dark room",
  "tags": [
    "dark",
    "warm",
    "editorial",
    "product",
    "minimal",
    "uppercase",
    "luxury"
  ],
  "fonts": [
    {
      "family": "Archivo",
      "role": "display",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Archivo",
      "note": "Grotesk with a tall x-height and flat terminals. Holds shape at 120px uppercase."
    },
    {
      "family": "Inter",
      "role": "sans",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/Inter",
      "note": "Fallback. Same skeleton, slightly narrower caps, so a missing Archivo does not reflow the page."
    },
    {
      "family": "DM Mono",
      "role": "mono",
      "license": "OFL-1.1",
      "url": "https://fonts.google.com/specimen/DM+Mono",
      "note": "Specs, model numbers and footnote credits only."
    }
  ],
  "tokens": {
    "color": {
      "bg": "#140d06",
      "surface": "#2e2015",
      "fg": "#f7e7cf",
      "muted": "#b39d86",
      "accent": "#e2601a",
      "accentFg": "#140d06",
      "border": "#443729",
      "success": "#93a862",
      "danger": "#e0655a"
    },
    "font": {
      "sans": "\"Archivo\", \"Inter\", \"Helvetica Neue\", Arial, sans-serif",
      "mono": "\"DM Mono\", ui-monospace, \"SFMono-Regular\", Menlo, monospace",
      "display": "\"Archivo\", \"Inter\", \"Helvetica Neue\", Arial, sans-serif",
      "scale": 1.2,
      "baseSize": "18px",
      "weightBody": 400,
      "weightHeading": 500,
      "headingTracking": 0
    },
    "space": {
      "unit": "6px",
      "gutter": "18px",
      "section": "160px",
      "maxWidth": "1440px"
    },
    "stroke": {
      "width": "1px"
    },
    "radius": {
      "sm": "12px",
      "md": "22px",
      "lg": "36px",
      "full": "9999px"
    },
    "motion": {
      "duration": "250ms",
      "easing": "cubic-bezier(0.33, 0, 0.2, 1)"
    }
  },
  "derived": {
    "type": [
      {
        "name": "xs",
        "size": "12.5px"
      },
      {
        "name": "sm",
        "size": "15px"
      },
      {
        "name": "base",
        "size": "18px"
      },
      {
        "name": "lg",
        "size": "21.6px"
      },
      {
        "name": "xl",
        "size": "25.92px"
      },
      {
        "name": "2xl",
        "size": "31.1px"
      },
      {
        "name": "3xl",
        "size": "37.32px"
      },
      {
        "name": "4xl",
        "size": "44.79px"
      }
    ],
    "space": [
      {
        "step": 1,
        "size": "6px"
      },
      {
        "step": 2,
        "size": "12px"
      },
      {
        "step": 3,
        "size": "18px"
      },
      {
        "step": 4,
        "size": "24px"
      },
      {
        "step": 6,
        "size": "36px"
      },
      {
        "step": 8,
        "size": "48px"
      },
      {
        "step": 12,
        "size": "72px"
      },
      {
        "step": 16,
        "size": "96px"
      },
      {
        "step": 24,
        "size": "144px"
      }
    ]
  },
  "variables": {
    "color-bg": "#140d06",
    "color-surface": "#2e2015",
    "color-fg": "#f7e7cf",
    "color-muted": "#b39d86",
    "color-accent": "#e2601a",
    "color-accent-fg": "#140d06",
    "color-border": "#443729",
    "color-success": "#93a862",
    "color-danger": "#e0655a",
    "font-sans": "\"Archivo\", \"Inter\", \"Helvetica Neue\", Arial, sans-serif",
    "font-mono": "\"DM Mono\", ui-monospace, \"SFMono-Regular\", Menlo, monospace",
    "font-display": "\"Archivo\", \"Inter\", \"Helvetica Neue\", Arial, sans-serif",
    "font-weight-body": "400",
    "font-weight-heading": "500",
    "heading-tracking": "0em",
    "text-xs": "12.5px",
    "text-sm": "15px",
    "text-base": "18px",
    "text-lg": "21.6px",
    "text-xl": "25.92px",
    "text-2xl": "31.1px",
    "text-3xl": "37.32px",
    "text-4xl": "44.79px",
    "space-1": "6px",
    "space-2": "12px",
    "space-3": "18px",
    "space-4": "24px",
    "space-6": "36px",
    "space-8": "48px",
    "space-12": "72px",
    "space-16": "96px",
    "space-24": "144px",
    "gutter": "18px",
    "section": "160px",
    "max-width": "1440px",
    "stroke-width": "1px",
    "radius-sm": "12px",
    "radius-md": "22px",
    "radius-lg": "36px",
    "radius-full": "9999px",
    "duration": "250ms",
    "easing": "cubic-bezier(0.33, 0, 0.2, 1)"
  }
}
