---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const entries = (await getCollection("styles")).sort((a, b) => a.data.name.localeCompare(b.data.name));
const searchDocs = entries.map(({ data }) => ({
  id: data.id, name: data.name, mood: data.mood, summary: data.summary,
  tags: data.tags.join(" "),
  type: [data.tokens.font.sans, data.tokens.font.mono, data.tokens.font.display ?? ""].join(" "),
  palette: Object.values(data.tokens.color).filter(Boolean).join(" "),
}));
const tagCounts = new Map<string, number>();
for (const { data } of entries) {
  for (const tag of data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
// Presentation groups only: options come from authored tags. New tags
// automatically appear under Character, without a schema or taxonomy change.
const tones = ["light", "dark"];
const uses = ["saas", "product", "enterprise", "editorial", "blog", "docs", "reference", "developer", "healthcare", "consumer"];
const typography = ["mono", "serif"];
const labels: Record<string, string> = {
  saas: "SaaS", product: "Product", enterprise: "Business", editorial: "Editorial",
  blog: "Blog", docs: "Documentation", reference: "Reference", developer: "Developer",
  healthcare: "Healthcare", consumer: "Consumer", mono: "Monospace", serif: "Serif",
};
const label = (tag: string) => labels[tag] ?? tag.replace(/-/g, " ").replace(/^./, (c) => c.toUpperCase());
const character = [...tagCounts.keys()]
  .filter((tag) => ![...tones, ...uses, ...typography].includes(tag))
  .sort((a, b) => tagCounts.get(b)! - tagCounts.get(a)! || a.localeCompare(b));
const groups = [
  { name: "Use case", tags: uses.filter((t) => tagCounts.has(t)), extra: [] as string[] },
  { name: "Typography", tags: typography.filter((t) => tagCounts.has(t)), extra: [] as string[] },
  { name: "Character", tags: character.slice(0, 8), extra: character.slice(8) },
];
---

<Base title="styles-md · find your next design style" description="Explore design styles by mood, use case, typography and palette. Preview the same interface in every style, then take it into your project.">
  <div class="wrap discovery">
    <section class="discovery-intro" aria-labelledby="discovery-title">
      <div>
        <p class="eyebrow">The design style library</p>
        <h1 id="discovery-title">Find the right feel.</h1>
        <p class="discovery-lede">Every style renders the same demo page, so what you are comparing is the design and not the screenshot.</p>
      </div>
      <p class="library-note"><span class="note-dot" aria-hidden="true"></span>{entries.length} open styles</p>
    </section>

    <search class="discovery-search" aria-label="Find design styles">
      <div class="searchbox">
        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
        <input id="q" type="search" placeholder="Search styles, moods, fonts or colors…" autocomplete="off" aria-label="Search styles" aria-describedby="search-help" aria-controls="grid" />
        <kbd aria-hidden="true">/</kbd>
      </div>
      <p class="search-help" id="search-help">Try a direction:
        <button type="button" data-query="minimal">minimal</button>
        <button type="button" data-query="editorial">editorial</button>
        <button type="button" data-query="#7c8cf8">#7c8cf8</button>
      </p>
    </search>

    <div class="browse-layout">
      <aside class="filter-rail" aria-label="Style filters">
        <details class="filter-panel" id="filter-panel" open>
          <summary>Filters <span id="filter-count"></span><span class="filter-chevron" aria-hidden="true">⌄</span></summary>
          <div class="filter-content">
            <fieldset class="filter-group">
              <legend>Appearance</legend>
              <div class="tone-options">
                <button class="tone-option" type="button" data-tone="" aria-pressed="true">Any</button>
                {tones.map((tone) => <button class="tone-option" type="button" data-tone={tone} aria-pressed="false"><span class={`tone-dot ${tone}`} aria-hidden="true"></span>{label(tone)}</button>)}
              </div>
            </fieldset>
            {groups.map((group) => (
              <fieldset class="filter-group">
                <legend>{group.name}</legend>
                <div class:list={["filter-options", { "use-options": group.name === "Use case" }]}>
                  {group.tags.map((tag) => (
                    <button class="filter-option" type="button" data-tag={tag} data-label={label(tag)} aria-pressed="false">
                      <span>{label(tag)}</span><span class="n" aria-hidden="true">{tagCounts.get(tag)}</span>
                    </button>
                  ))}
                </div>
                {group.extra.length > 0 && <details class="more-filters" id="more-filters">
                  <summary>More attributes <span aria-hidden="true">+</span></summary>
                  <div class="filter-options">
                    {group.extra.map((tag) => <button class="filter-option" type="button" data-tag={tag} data-label={label(tag)} aria-pressed="false"><span>{label(tag)}</span><span class="n" aria-hidden="true">{tagCounts.get(tag)}</span></button>)}
                  </div>
                </details>}
              </fieldset>
            ))}
            <p class="filter-hint">Combine filters to narrow your search.</p>
          </div>
        </details>
      </aside>

      <section class="results" aria-labelledby="results-title">
        <div class="results-head">
          <div class="results-heading"><h2 id="results-title">All styles</h2><p class="count" id="count" role="status" aria-live="polite" aria-atomic="true">{entries.length} styles</p></div>
          <span class="sort-note" id="sort-note">Name A-Z</span>
        </div>
        <div class="active-filters" id="active-filters" hidden>
          <div class="active-list" id="active-list" aria-label="Active filters"></div>
          <button class="linkish" type="button" id="clear">Clear all</button>
        </div>
        <div class="grid" id="grid">
          {entries.map(({ data }, index) => (
            <a class="style-card" href={`/styles/${data.id}/`} data-id={data.id}>
              <div class="card-preview">
                <img class="thumb" src={`/styles/${data.id}/preview.webp`} alt={`The demo page rendered in ${data.name}`} width="1280" height="900" loading={index < 3 ? "eager" : "lazy"} style={`background:${data.tokens.color.bg}`} />
              </div>
              <div class="meta">
                <div class="top"><h3>{data.name}</h3><span class="go" aria-hidden="true">↗</span></div>
                <p class="mood">{data.mood}</p>
                <div class="card-details">
                  <div class="tags">{data.tags.filter((tag) => !tones.includes(tag)).slice(0, 2).map((tag) => <span class="tag">{label(tag)}</span>)}</div>
                  <div class="swatches" aria-label="Color palette">{[data.tokens.color.bg, data.tokens.color.fg, data.tokens.color.accent].map((color) => <span style={`background:${color}`} title={color}></span>)}</div>
                </div>
              </div>
            </a>
          ))}
        </div>
        <div class="empty" id="empty" hidden>
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4M8 10.5h5"/></svg>
          <h3>No styles found</h3>
          <p>Try a broader word, or remove a filter to see more styles.</p>
          <button class="copy" type="button" id="reset">Reset search and filters</button>
        </div>
        <p class="comparison-note">Same interface, different styles. Open a preview to explore the details.</p>
      </section>
    </div>
  </div>
  <script type="application/json" id="search-docs" set:html={JSON.stringify(searchDocs).replace(/</g, "\\u003c")} />
  <script src="../scripts/gallery.ts"></script>
</Base>
